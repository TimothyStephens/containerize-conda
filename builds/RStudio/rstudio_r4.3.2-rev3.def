Bootstrap: docker
From: rocker/rstudio:4.3.2

%environment
  export LC_ALL=C
  export NUMBA_CACHE_DIR=/tmp/numba_cache
  export PAGEDOWN_CHROME = "/opt/chrome-shell/chrome-headless-shell-linux64/chrome-headless-shell"

%post
  # 1. Force APT to stay as root and disable sandboxing
  echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/sandbox-disable
  
  # So we dont have to interactivly configure tzdata
  ln -fs /usr/share/zoneinfo/America/New_York /etc/localtime
  DEBIAN_FRONTEND=noninteractive

  # Install essential packages
  apt-get update && apt-get -y upgrade
  apt-get -y install \
    build-essential \
    curl \
    wget \
    bzip2 \
    unzip \
    ca-certificates \
    git \
    libglib2.0-0 \
    libxext6 \
    libsm6 \
    libxrender1 \
    libxml2 \
    libxt6 \
    zlib1g-dev \
    libbz2-dev \
    liblzma-dev \
    libpcre3-dev \
    libicu-dev \
    libjpeg-dev \
    libpng-dev \
    libxml2-dev \
    libglpk-dev \
    libnspr4 \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libasound2
  rm -rf /var/lib/apt/lists/*
  apt-get clean

  # Pull a completely standalone browser build into an global share folder
  mkdir -p /opt/chrome-shell
  cd /opt/chrome-shell
  wget https://storage.googleapis.com/chrome-for-testing-public/149.0.7827.55/linux64/chrome-headless-shell-linux64.zip
  unzip chrome-headless-shell-linux64.zip
  rm -fr chrome-headless-shell-linux64.zip
  chmod -R 755 /opt/chrome-shell

%labels
  Program RStudio-R_v4.3.2
  ProgramVersion v4.3.2
  ContainerVersion 2
  Website https://github.com/rocker-org/rocker-versioned2

%help

###############################
#### RStudio with R v4.3.2 ####
###############################

RStudio server running R v4.3.2


COMMANDS:  
  
  Basic run examples:
    singularity exec \
      --bind run:/run,var-lib-rstudio-server:/var/lib/rstudio-server,database.conf:/etc/rstudio/database.conf \
      rstudio_r4.3.2-rev2.sif /usr/lib/rstudio-server/bin/rserver \
        --auth-none=0 --auth-pam-helper-path=pam-helper --server-user=$(whoami)


